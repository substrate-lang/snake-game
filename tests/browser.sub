;; Tests that use the examples as a user would, in Chromium.
(require-unqualified std/test/browser)
(require-unqualified std/test/test)

(test snake
  (with-browser (b "snake")
    (browser-advance! b 100)
    (expect-text b (by-css ".status") "Click the board to play.")
    (browser-click! b (by-css ".board"))
    (expect-text b (by-css ".status") "Press an arrow key to start.")
    (expect-text b (by-css ".score") "0")
    (expect-drawn b (by-css ".board") "fill-style \"#b4f1a7\"\nfill-rect 201 201 18 18")
    (browser-press! b "ArrowRight")
    (expect-text b (by-css ".status") "Arrow keys or W A S D to turn. Space to pause.")
    (browser-advance! b 1000)
    (expect (not (browser-drawn? b (by-css ".board") "fill-style \"#b4f1a7\"\nfill-rect 201 201 18 18")))
    (browser-press! b " ")
    (expect-text b (by-css ".status") "Paused. Press Space to continue.")
    (browser-press! b " ")
    (expect-text b (by-css ".status") "Arrow keys or W A S D to turn. Space to pause.")
    (browser-advance! b 20000)
    (expect-text b (by-css ".status") "Game over. Press Enter to play again.")
    (browser-press! b "ArrowLeft")
    (expect-text b (by-css ".status") "Game over. Press Enter to play again.")
    (browser-press! b "Enter")
    (expect-text b (by-css ".status") "Press an arrow key to start.")
    (browser-click! b (by-role "button" "New game"))
    (expect-text b (by-css ".status") "Press an arrow key to start.")
    (browser-press! b "a")
    (expect-text b (by-css ".status") "Arrow keys or W A S D to turn. Space to pause.")))

(test snake-blur
  (with-browser (b "snake")
    (browser-click! b (by-css ".board"))
    (browser-press! b "ArrowRight")
    (expect-text b (by-css ".status") "Arrow keys or W A S D to turn. Space to pause.")
    (browser-click! b (by-css ".status"))
    (expect-text b (by-css ".status") "Click the board to play.")
    (browser-click! b (by-css ".board"))
    (expect-text b (by-css ".status") "Paused. Press Space to continue.")))

(test snake-best-score
  (with-browser (b "snake")
    (browser-storage-set! b "best" "42")
    (browser-reload! b)
    (expect-text b (by-css ".best") "42")))
